<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:KursMVVM.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
             x:Class="KursMVVM.Views.ContractsPageView">

  <Grid RowDefinitions="Auto,*">
    <!-- Action Toolbar -->
    <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,12" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button Content="Добавить" Command="{Binding AddCommand}"
                  Background="#0284C7" Foreground="White" Padding="16,8" FontWeight="Medium" FontSize="13" CornerRadius="6" BorderThickness="0"/>
          <Button Content="Редактировать" Command="{Binding EditCommand}"
                  Background="#262626" Foreground="#E4E4E7" BorderBrush="#3F3F46" BorderThickness="1" Padding="14,8" FontWeight="Medium" FontSize="13" CornerRadius="6"/>
          <Button Content="Удалить" Command="{Binding DeleteCommand}"
                  Background="#2E1418" Foreground="#F87171" BorderBrush="#5C1D24" BorderThickness="1" Padding="14,8" FontWeight="Medium" FontSize="13" CornerRadius="6"/>
        </StackPanel>

        <Border Grid.Column="2" Background="#262626" BorderBrush="#333333" BorderThickness="1" Padding="12,6" CornerRadius="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding Contracts.Count, StringFormat='Всего договоров: {0}'}" FontSize="12" FontWeight="Medium" Foreground="#A1A1AA"/>
        </Border>
      </Grid>
    </Border>

    <!-- Data Table Container -->
    <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <!-- Table Header Row -->
        <Border Grid.Row="0" Background="#222222" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="16,10" CornerRadius="8,8,0,0">
          <Grid ColumnDefinitions="140,2*,3*,140">
            <TextBlock Text="НОМЕР ДОГОВОРА" Grid.Column="0" FontWeight="Bold" FontSize="11" Foreground="#71717A"/>
            <TextBlock Text="ОТВЕТСТВЕННЫЙ СОТРУДНИК" Grid.Column="1" FontWeight="Bold" FontSize="11" Foreground="#71717A" Margin="10,0"/>
            <TextBlock Text="НАИМЕНОВАНИЕ ОРГАНИЗАЦИИ" Grid.Column="2" FontWeight="Bold" FontSize="11" Foreground="#71717A" Margin="10,0"/>
            <TextBlock Text="ДАТА ЗАКЛЮЧЕНИЯ" Grid.Column="3" FontWeight="Bold" FontSize="11" Foreground="#71717A"/>
          </Grid>
        </Border>

        <!-- Table Data Rows -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}" Background="Transparent" Padding="8,4">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,10"/>
              <Setter Property="Margin" Value="0,2"/>
              <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="#27272A"/>
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="#202020"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="140,2*,3*,140">
                <Border Grid.Column="0" Background="#164E63" BorderBrush="#0284C7" BorderThickness="1" Padding="8,3" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ContractNumber}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8"/>
                </Border>
                <TextBlock Text="{Binding Employee.FullName}" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="10,0"/>
                <TextBlock Text="{Binding OrganizationName}" Grid.Column="2" VerticalAlignment="Center" Foreground="#D4D4D8" Margin="10,0"/>
                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" Grid.Column="3" VerticalAlignment="Center" Foreground="#71717A"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>