<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:KursMVVM.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
             x:Class="KursMVVM.Views.ContractsPageView">

  <Grid RowDefinitions="Auto,*">
    <!-- Action Toolbar -->
    <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,12" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button Content="➕ Добавить договор" Command="{Binding AddCommand}"
                  Background="#10B981" Foreground="White" Padding="14,8" FontWeight="SemiBold" FontSize="13" CornerRadius="6" BorderThickness="0"/>
          <Button Content="✏️ Редактировать" Command="{Binding EditCommand}"
                  Background="#3B82F6" Foreground="White" Padding="14,8" FontWeight="SemiBold" FontSize="13" CornerRadius="6" BorderThickness="0"/>
          <Button Content="🗑️ Удалить" Command="{Binding DeleteCommand}"
                  Background="#EF4444" Foreground="White" Padding="14,8" FontWeight="SemiBold" FontSize="13" CornerRadius="6" BorderThickness="0"/>
        </StackPanel>

        <Border Grid.Column="2" Background="#F1F5F9" Padding="12,6" CornerRadius="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding Contracts.Count, StringFormat='Всего договоров: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
        </Border>
      </Grid>
    </Border>

    <!-- Data Table Container -->
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <!-- Table Header Row -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10" CornerRadius="10,10,0,0">
          <Grid ColumnDefinitions="140,2*,3*,140">
            <TextBlock Text="НОМЕР ДОГОВОРА" Grid.Column="0" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
            <TextBlock Text="ОТВЕТСТВЕННЫЙ СОТРУДНИК" Grid.Column="1" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="10,0"/>
            <TextBlock Text="НАИМЕНОВАНИЕ ОРГАНИЗАЦИИ" Grid.Column="2" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="10,0"/>
            <TextBlock Text="ДАТА ЗАКЛЮЧЕНИЯ" Grid.Column="3" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
          </Grid>
        </Border>

        <!-- Table Data Rows -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}" Background="Transparent" Padding="8,4">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,10"/>
              <Setter Property="Margin" Value="0,2"/>
              <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="#EEF2FF"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="140,2*,3*,140">
                <Border Grid.Column="0" Background="#EEF2FF" Padding="8,3" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ContractNumber}" FontWeight="Bold" FontSize="12" Foreground="#4338CA"/>
                </Border>
                <TextBlock Text="{Binding Employee.FullName}" Grid.Column="1" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B" Margin="10,0"/>
                <TextBlock Text="{Binding OrganizationName}" Grid.Column="2" VerticalAlignment="Center" Foreground="#334155" Margin="10,0"/>
                <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Grid.Column="3" VerticalAlignment="Center" Foreground="#64748B"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>