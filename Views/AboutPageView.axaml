<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KursMVVM.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="KursMVVM.Views.AboutPageView">
  <Border Background="White" BorderBrush="#D2B48C" BorderThickness="2" CornerRadius="12" Margin="40" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="15" HorizontalAlignment="Center">
      <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="Bold" Foreground="#5C4033" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding Version}" FontSize="16" Foreground="#8B7355" HorizontalAlignment="Center"/>
      <Border Height="2" Background="#D2B48C" Margin="0,10"/>
      <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#5C4033" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" LineHeight="22"/>
      <TextBlock Text="© 2025 Курсовая работа" FontSize="12" Foreground="#8B7355" HorizontalAlignment="Center" Margin="0,20,0,0"/>
    </StackPanel>
  </Border>
</UserControl>