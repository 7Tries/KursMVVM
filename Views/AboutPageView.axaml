<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KursMVVM.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="KursMVVM.Views.AboutPageView">

  <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Margin="40" Padding="40"
          HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
    <StackPanel Spacing="16" HorizontalAlignment="Center">
      <Border Width="64" Height="64" Background="#EEF2FF" CornerRadius="16" HorizontalAlignment="Center">
        <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>

      <Border Background="#F1F5F9" Padding="12,4" CornerRadius="12" HorizontalAlignment="Center">
        <TextBlock Text="{Binding Version, StringFormat='Версия {0} (Релиз)'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
      </Border>

      <Border Height="1" Background="#E2E8F0" Margin="20,8"/>

      <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#475569" TextWrapping="Wrap"
                 TextAlignment="Center" LineHeight="22"/>

      <Grid ColumnDefinitions="*,*,*" Margin="0,12,0,0">
        <Border Grid.Column="0" Margin="4" Padding="10" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <TextBlock Text="🖥️ Стек" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
            <TextBlock Text="Avalonia 11" FontSize="12" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="4" Padding="10" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <TextBlock Text="💾 СУБД" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
            <TextBlock Text="SQLite (EF Core)" FontSize="12" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Margin="4" Padding="10" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <TextBlock Text="📊 Графика" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
            <TextBlock Text="LiveCharts2" FontSize="12" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="© 2025–2026 Курсовая работа • Все права защищены" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </StackPanel>
  </Border>
</UserControl>