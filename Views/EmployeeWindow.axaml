<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:KursMVVM.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Width="460" Height="530"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        x:Class="KursMVVM.Views.EmployeeWindow"
        Title="Карточка сотрудника"
        Background="#181818">

  <Border Margin="20" Background="#1F1F1F" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="24">
    <StackPanel Spacing="12">
      <TextBlock Text="Карточка сотрудника" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Center" Margin="0,0,0,8"/>

      <StackPanel Spacing="4">
        <TextBlock Text="Код отдела:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding DepartmentCode, Converter={StaticResource StringToIntConverter}}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="ФИО сотрудника:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding FullName}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Должность:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding Position}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
          <TextBlock Text="Оклад (руб.):" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
          <TextBox Text="{Binding Salary, Converter={StaticResource StringToDecimalConverter}}"
                   Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
          <TextBlock Text="Премия (руб.):" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
          <TextBox Text="{Binding Bonus, Converter={StaticResource StringToDecimalConverter}}"
                   Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="4">
        <TextBlock Text="Месяц начисления (YYYY-MM):" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding Month}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,14,0,0">
        <Button Content="Сохранить" Click="Save_Click"
                Background="#0284C7" Foreground="White" Padding="22,8" FontWeight="Medium" FontSize="13" CornerRadius="6" BorderThickness="0"/>
        <Button Content="Отмена" Click="Cancel_Click"
                Background="#262626" Foreground="#A1A1AA" BorderBrush="#383838" BorderThickness="1" Padding="20,8" FontWeight="Medium" FontSize="13" CornerRadius="6"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>