<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:KursMVVM.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Width="460" Height="430"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        x:Class="KursMVVM.Views.SupplyWindow"
        Title="Карточка поставки"
        Background="#F8FAFC">

  <Border Margin="20" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,8">
        <Border Width="30" Height="30" Background="#EEF2FF" CornerRadius="6" VerticalAlignment="Center">
          <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Карточка поставки" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Номер договора:" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding ContractNumber}"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Тип оборудования:" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding EquipmentType}"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Комментарий пользователя о работе ПО:" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Comment}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Код ответственного сотрудника:" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding EmployeeId, Converter={StaticResource StringToIntConverter}}"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,14,0,0">
        <Button Content="💾 Сохранить" Click="Save_Click"
                Background="#10B981" Foreground="White" Padding="22,8" FontWeight="Bold" FontSize="13" CornerRadius="6" BorderThickness="0"/>
        <Button Content="Отмена" Click="Cancel_Click"
                Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20,8" FontWeight="SemiBold" FontSize="13" CornerRadius="6"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>