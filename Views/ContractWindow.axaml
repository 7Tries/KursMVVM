<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:KursMVVM.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Width="460" Height="440"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        x:Class="KursMVVM.Views.ContractWindow"
        Title="Карточка договора"
        Background="#181818">

  <Border Margin="20" Background="#1F1F1F" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="24">
    <StackPanel Spacing="12">
      <TextBlock Text="Карточка договора" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Center" Margin="0,0,0,8"/>

      <StackPanel Spacing="4">
        <TextBlock Text="Номер договора:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding ContractNumber}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Код ответственного сотрудника:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding EmployeeId, Converter={StaticResource StringToIntConverter}}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Наименование организации:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding OrganizationName}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="Дата заключения договора:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <DatePicker SelectedDate="{Binding Date, Converter={StaticResource DateTimeToDateTimeOffsetConverter}, Mode=TwoWay}"
                    Background="#262626" BorderBrush="#383838" CornerRadius="6" HorizontalAlignment="Stretch"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,14,0,0">
        <Button Content="Сохранить" Click="Save_Click"
                Background="#0284C7" Foreground="White" Padding="22,8" FontWeight="Medium" FontSize="13" CornerRadius="6" BorderThickness="0"/>
        <Button Content="Отмена" Click="Cancel_Click"
                Background="#262626" Foreground="#A1A1AA" BorderBrush="#383838" BorderThickness="1" Padding="20,8" FontWeight="Medium" FontSize="13" CornerRadius="6"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>