<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KursMVVM.ViewModels"
        xmlns:local="using:KursMVVM"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="850"
        x:Class="KursMVVM.Views.MainWindow"
        Title="{Binding Title}"
        Width="1280" Height="850"
        MinWidth="960" MinHeight="650"
        Background="#141414">

  <Window.DataTemplates>
    <local:ViewLocator/>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Button.NavBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9E9E9E"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.NavBtn:pointerover">
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.NavBtn:pressed">
      <Setter Property="Background" Value="#222222"/>
      <Setter Property="Foreground" Value="#38BDF8"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Left Navigation Sidebar -->
    <Border DockPanel.Dock="Left" Width="240" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Brand Header Card -->
        <Border Grid.Row="0" Margin="16,20,16,14" Padding="14,12" Background="#252525" CornerRadius="8" BorderBrush="#2E2E2E" BorderThickness="1">
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Width="26" Height="26" Background="#164E63" CornerRadius="6" VerticalAlignment="Center">
                <TextBlock Text="УП" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Учёт поставок" FontSize="14" FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Информационная система" FontSize="11" Foreground="#71717A" Margin="36,0,0,0"/>
          </StackPanel>
        </Border>

        <!-- Navigation Menu Items -->
        <ScrollViewer Grid.Row="1" Margin="10,4">
          <StackPanel Spacing="2">
            <TextBlock Text="СПРАВОЧНИКИ" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="14,8,14,6"/>

            <Button Classes="NavBtn" Content="Сотрудники" Command="{Binding NavigateCommand}" CommandParameter="Employees"/>
            <Button Classes="NavBtn" Content="Договоры" Command="{Binding NavigateCommand}" CommandParameter="Contracts"/>
            <Button Classes="NavBtn" Content="Поставки" Command="{Binding NavigateCommand}" CommandParameter="Supplies"/>
            <Button Classes="NavBtn" Content="Организации" Command="{Binding NavigateCommand}" CommandParameter="Organizations"/>

            <TextBlock Text="АНАЛИТИКА" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="14,16,14,6"/>

            <Button Classes="NavBtn" Content="Отчёты" Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
            <Button Classes="NavBtn" Content="Графики" Command="{Binding NavigateCommand}" CommandParameter="Graphs"/>
            <Button Classes="NavBtn" Content="Импорт и экспорт" Command="{Binding NavigateCommand}" CommandParameter="ImportExport"/>

            <TextBlock Text="СИСТЕМА" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="14,16,14,6"/>
            <Button Classes="NavBtn" Content="О программе" Command="{Binding NavigateCommand}" CommandParameter="About"/>

            <!-- Banner under all tabs -->
            <Border Margin="4,20,4,10" CornerRadius="8" ClipToBounds="True" BorderBrush="#2C2C2C" BorderThickness="1" Background="#242424">
              <Image Source="avares://KursMVVM/Assets/banner.png" Stretch="Uniform" HorizontalAlignment="Stretch"/>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Footer status pill -->
        <Border Grid.Row="2" Margin="16,12,16,16" Padding="12,8" Background="#242424" CornerRadius="6" BorderBrush="#2E2E2E" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Width="6" Height="6" Background="#10B981" CornerRadius="3" VerticalAlignment="Center"/>
            <TextBlock Text="База данных подключена" FontSize="11" Foreground="#A1A1AA" FontWeight="Medium" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Main Content Area -->
    <Border Background="#141414" Padding="20">
      <ContentControl Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Border>
  </DockPanel>
</Window>