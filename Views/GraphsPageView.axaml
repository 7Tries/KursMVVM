<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:KursMVVM.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
             x:Class="KursMVVM.Views.GraphsPageView">

  <Grid RowDefinitions="Auto,*">
    <!-- Top Bar with Info and Refresh Button -->
    <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,14" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Text="Визуализация данных и интерактивные графики" FontSize="18" FontWeight="Bold" Foreground="#F4F4F5"/>
          <TextBlock Text="Сводная сетка 2х2 и полноэкранный просмотр графиков" FontSize="12" Foreground="#71717A"/>
        </StackPanel>

        <Button Grid.Column="1" Content="Обновить графики" Command="{Binding RefreshCommand}"
                Background="#262626" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1"
                Padding="14,8" FontWeight="Medium" FontSize="13" CornerRadius="6"/>
      </Grid>
    </Border>

    <!-- Tabbed Chart Presentation Container -->
    <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="14">
      <TabControl SelectedIndex="{Binding SelectedViewModeIndex}">
        <TabControl.Styles>
          <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
          </Style>
          <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#38BDF8"/>
          </Style>
        </TabControl.Styles>

        <!-- Tab 0: Все графики (2x2) -->
        <TabItem Header="Обзор 2×2">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" Margin="0,0,4,10">

              <!-- Chart 1: Договоры -->
              <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="16" MinHeight="320">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Договоры по сотрудникам" FontWeight="Bold" FontSize="14" Foreground="#F4F4F5"/>
                    <TextBlock Text="Количество контрактов, заключённых сотрудниками" FontSize="11" Foreground="#71717A"/>
                  </StackPanel>
                  <lvc:CartesianChart Grid.Row="1" Series="{Binding ContractsByEmployeeSeries}" XAxes="{Binding ContractsByEmployeeXAxes}" Background="Transparent" MinHeight="240"/>
                </Grid>
              </Border>

              <!-- Chart 2: Доля оборудования (Pie Chart) -->
              <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,12" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="16" MinHeight="320">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="Доля поставок по типам оборудования" FontWeight="Bold" FontSize="14" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Background="#164E63" BorderBrush="#0284C7" BorderThickness="1" Padding="8,2" CornerRadius="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalEquipmentCount, StringFormat='Всего: {0} шт.'}" FontSize="11" Foreground="#38BDF8" FontWeight="Medium"/>
                      </Border>
                    </Grid>
                    <TextBlock Text="Структура поставленного оборудования" FontSize="11" Foreground="#71717A"/>
                  </StackPanel>
                  <lvc:PieChart Grid.Row="1" Series="{Binding EquipmentTypeSeries}" LegendPosition="Right" Background="Transparent" MinHeight="240"/>
                </Grid>
              </Border>

              <!-- Chart 3: Динамика -->
              <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="16" MinHeight="320">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Динамика договоров по месяцам" FontWeight="Bold" FontSize="14" Foreground="#F4F4F5"/>
                    <TextBlock Text="Помесячная хронология заключения договоров" FontSize="11" Foreground="#71717A"/>
                  </StackPanel>
                  <lvc:CartesianChart Grid.Row="1" Series="{Binding ContractDynamicsSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Background="Transparent" MinHeight="240"/>
                </Grid>
              </Border>

              <!-- Chart 4: Оклады -->
              <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="16" MinHeight="320">
                <Grid RowDefinitions="Auto,*">
                  <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Распределение окладов" FontWeight="Bold" FontSize="14" Foreground="#F4F4F5"/>
                    <TextBlock Text="Базовый оклад по штату сотрудников (руб.)" FontSize="11" Foreground="#71717A"/>
                  </StackPanel>
                  <lvc:CartesianChart Grid.Row="1" Series="{Binding SalaryDistributionSeries}" Background="Transparent" MinHeight="240"/>
                </Grid>
              </Border>

            </Grid>
          </ScrollViewer>
        </TabItem>

        <!-- Tab 1: Договоры (Full Screen) -->
        <TabItem Header="Договоры по сотрудникам">
          <Border Margin="0,10,0,0" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Столбчатая диаграмма: Договоры по сотрудникам" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                <TextBlock Text="Сравнение производительности сотрудников по количеству заключённых договоров" FontSize="12" Foreground="#71717A"/>
              </StackPanel>
              <lvc:CartesianChart Grid.Row="1" Series="{Binding ContractsByEmployeeSeries}" XAxes="{Binding ContractsByEmployeeXAxes}" Background="Transparent" MinHeight="450"/>
            </Grid>
          </Border>
        </TabItem>

        <!-- Tab 2: Доля поставок (Pie Chart Full Screen) -->
        <TabItem Header="Доля оборудования">
          <Border Margin="0,10,0,0" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Круговая диаграмма: Доля поставок по типам оборудования" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                  <TextBlock Text="Наглядное процентное соотношение категорий поставленного оборудования" FontSize="12" Foreground="#71717A"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#164E63" BorderBrush="#0284C7" BorderThickness="1" Padding="14,6" CornerRadius="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TotalEquipmentCount, StringFormat='Общий объём: {0} единиц'}" FontSize="13" Foreground="#38BDF8" FontWeight="Medium"/>
                </Border>
              </Grid>
              <lvc:PieChart Grid.Row="1" Series="{Binding EquipmentTypeSeries}" LegendPosition="Right" Background="Transparent" MinHeight="450"/>
            </Grid>
          </Border>
        </TabItem>

        <!-- Tab 3: Динамика договоров (Full Screen) -->
        <TabItem Header="Динамика договоров">
          <Border Margin="0,10,0,0" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Линейный график: Динамика заключения договоров" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                <TextBlock Text="Хронологический тренд подписания контрактов по отчётным месяцам" FontSize="12" Foreground="#71717A"/>
              </StackPanel>
              <lvc:CartesianChart Grid.Row="1" Series="{Binding ContractDynamicsSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Background="Transparent" MinHeight="450"/>
            </Grid>
          </Border>
        </TabItem>

        <!-- Tab 4: Распределение окладов (Full Screen) -->
        <TabItem Header="Распределение окладов">
          <Border Margin="0,10,0,0" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Гистограмма: Распределение окладов сотрудников" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                <TextBlock Text="Сопоставление уровней ежемесячной базовой оплаты труда по штату" FontSize="12" Foreground="#71717A"/>
              </StackPanel>
              <lvc:CartesianChart Grid.Row="1" Series="{Binding SalaryDistributionSeries}" Background="Transparent" MinHeight="450"/>
            </Grid>
          </Border>
        </TabItem>

      </TabControl>
    </Border>
  </Grid>
</UserControl>