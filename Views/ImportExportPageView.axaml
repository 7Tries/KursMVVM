<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:KursMVVM.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="750"
             x:Class="KursMVVM.Views.ImportExportPageView">

  <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,0,10">
    <!-- Top Header -->
    <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,14" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Text="📤 Модуль обмена данными (Импорт и Экспорт)" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
          <TextBlock Text="Гибкая выгрузка справочников и аналитических отчётов в различные форматы" FontSize="12" Foreground="#64748B"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" Foreground="#065F46" FontWeight="SemiBold" FontSize="12"/>
        </Border>
      </Grid>
    </Border>

    <!-- Import & Export Control Panels (2 Columns) -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,16">
      <!-- Left Panel: IMPORT -->
      <Border Grid.Column="0" Margin="0,0,8,0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="24" Height="24" Background="#ECFDF5" CornerRadius="6">
              <TextBlock Text="📥" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Импорт данных" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Загрузка информации в базу данных с валидацией обязательных полей и контролем внешних ключей:" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>

          <WrapPanel Margin="0,6,0,0">
            <Button Content="📄 CSV файл" Margin="0,0,8,8" Command="{Binding ImportCsvCommand}"
                    Background="#ECFDF5" Foreground="#065F46" BorderBrush="#A7F3D0" BorderThickness="1"
                    Padding="14,8" FontWeight="SemiBold" FontSize="12" CornerRadius="6"/>
            <Button Content="📊 Excel (XLSX)" Margin="0,0,8,8" Command="{Binding ImportExcelCommand}"
                    Background="#ECFDF5" Foreground="#065F46" BorderBrush="#A7F3D0" BorderThickness="1"
                    Padding="14,8" FontWeight="SemiBold" FontSize="12" CornerRadius="6"/>
            <Button Content="📦 JSON файл" Margin="0,0,8,8" Command="{Binding ImportJsonCommand}"
                    Background="#ECFDF5" Foreground="#065F46" BorderBrush="#A7F3D0" BorderThickness="1"
                    Padding="14,8" FontWeight="SemiBold" FontSize="12" CornerRadius="6"/>
            <Button Content="📑 XML файл" Margin="0,0,8,8" Command="{Binding ImportXmlCommand}"
                    Background="#ECFDF5" Foreground="#065F46" BorderBrush="#A7F3D0" BorderThickness="1"
                    Padding="14,8" FontWeight="SemiBold" FontSize="12" CornerRadius="6"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Right Panel: EXPORT WITH CHOICES -->
      <Border Grid.Column="1" Margin="8,0,0,0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="24" Height="24" Background="#EEF2FF" CornerRadius="6">
              <TextBlock Text="📤" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Настраиваемый экспорт" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Selectors: What and How -->
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
              <TextBlock Text="Что экспортируем:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
              <ComboBox ItemsSource="{Binding AvailableTargets}" SelectedItem="{Binding SelectedTarget}"
                        HorizontalAlignment="Stretch" Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="8,5"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
              <TextBlock Text="В какой формат:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
              <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}"
                        HorizontalAlignment="Stretch" Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="8,5"/>
            </StackPanel>
          </Grid>

          <!-- Action Buttons -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
            <Button Content="💾 Выполнить экспорт" Command="{Binding ExecuteCustomExportCommand}"
                    Background="#4F46E5" Foreground="White" Padding="16,8" FontWeight="Bold" FontSize="12" CornerRadius="6"/>
            <Button Content="Быстрый PDF" Command="{Binding ExportToPdfDirectCommand}"
                    Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#C7D2FE" BorderThickness="1"
                    Padding="12,8" FontWeight="SemiBold" FontSize="12" CornerRadius="6"/>
            <Button Content="Быстрый Excel" Command="{Binding ExportToExcelDirectCommand}"
                    Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#C7D2FE" BorderThickness="1"
                    Padding="12,8" FontWeight="SemiBold" FontSize="12" CornerRadius="6"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Bottom Section: Operation Logs -->
    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="📋 Журнал событий и операций" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
            <TextBlock Text="(лог выполненных операций, ошибок и результатов)" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
          </StackPanel>

          <Button Grid.Column="1" Content="🗑️ Очистить журнал" Command="{Binding ClearLogCommand}"
                  Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1"
                  Padding="10,4" FontSize="11" FontWeight="SemiBold" CornerRadius="6"/>
        </Grid>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4">
          <ListBox ItemsSource="{Binding LogMessages}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Foreground="#334155" Margin="4,2"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>