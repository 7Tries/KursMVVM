<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:KursMVVM.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Width="460" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        x:Class="KursMVVM.Views.OrganizationWindow"
        Title="Карточка организации"
        Background="#F8FAFC">

  <Border Margin="20" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,6">
        <Border Width="30" Height="30" Background="#EEF2FF" CornerRadius="6" VerticalAlignment="Center">
          <TextBlock Text="🏢" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Карточка организации" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="3">
          <TextBlock Text="Номер договора:" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
          <TextBox Text="{Binding ContractNumber}"
                   Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="3">
          <TextBlock Text="Код страны (2 буквы):" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
          <TextBox Text="{Binding CountryCode}"
                   Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="3">
        <TextBlock Text="Город:" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding City}"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Фактический адрес:" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Address}"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Номер телефона:" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Phone}"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Электронная почта (E-mail):" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Email}"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Веб-сайт (необязательно):" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Website}"
                 Background="#F8FAFC" BorderBrush="#CBD5E1" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,14,0,0">
        <Button Content="💾 Сохранить" Click="Save_Click"
                Background="#10B981" Foreground="White" Padding="22,8" FontWeight="Bold" FontSize="13" CornerRadius="6" BorderThickness="0"/>
        <Button Content="Отмена" Click="Cancel_Click"
                Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20,8" FontWeight="SemiBold" FontSize="13" CornerRadius="6"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>