<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:KursMVVM.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Width="460" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        x:Class="KursMVVM.Views.OrganizationWindow"
        Title="Карточка организации"
        Background="#181818">

  <Border Margin="20" Background="#1F1F1F" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="8" Padding="24">
    <StackPanel Spacing="10">
      <TextBlock Text="Карточка организации" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5" HorizontalAlignment="Center" Margin="0,0,0,6"/>

      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="3">
          <TextBlock Text="Номер договора:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
          <TextBox Text="{Binding ContractNumber}"
                   Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="3">
          <TextBlock Text="Код страны (2 буквы):" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
          <TextBox Text="{Binding CountryCode}"
                   Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="3">
        <TextBlock Text="Город:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding City}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Фактический адрес:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding Address}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Номер телефона:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding Phone}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Электронная почта:" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding Email}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Text="Веб-сайт (необязательно):" Foreground="#A1A1AA" FontSize="12" FontWeight="Medium"/>
        <TextBox Text="{Binding Website}"
                 Background="#262626" BorderBrush="#383838" CornerRadius="6" Padding="10,6"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,14,0,0">
        <Button Content="Сохранить" Click="Save_Click"
                Background="#0284C7" Foreground="White" Padding="22,8" FontWeight="Medium" FontSize="13" CornerRadius="6" BorderThickness="0"/>
        <Button Content="Отмена" Click="Cancel_Click"
                Background="#262626" Foreground="#A1A1AA" BorderBrush="#383838" BorderThickness="1" Padding="20,8" FontWeight="Medium" FontSize="13" CornerRadius="6"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>