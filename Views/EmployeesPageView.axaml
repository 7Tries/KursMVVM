<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:KursMVVM.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
             x:Class="KursMVVM.Views.EmployeesPageView">

  <Grid RowDefinitions="Auto,*">
    <!-- Action Toolbar -->
    <Border Grid.Row="0" Margin="0,0,0,16" Padding="16,12" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button Content="➕ Добавить сотрудника" Command="{Binding AddCommand}"
                  Background="#10B981" Foreground="White" Padding="14,8" FontWeight="SemiBold" FontSize="13" CornerRadius="6" BorderThickness="0"/>
          <Button Content="✏️ Редактировать" Command="{Binding EditCommand}"
                  Background="#3B82F6" Foreground="White" Padding="14,8" FontWeight="SemiBold" FontSize="13" CornerRadius="6" BorderThickness="0"/>
          <Button Content="🗑️ Удалить" Command="{Binding DeleteCommand}"
                  Background="#EF4444" Foreground="White" Padding="14,8" FontWeight="SemiBold" FontSize="13" CornerRadius="6" BorderThickness="0"/>
        </StackPanel>

        <Border Grid.Column="2" Background="#F1F5F9" Padding="12,6" CornerRadius="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding Employees.Count, StringFormat='Всего сотрудников: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
        </Border>
      </Grid>
    </Border>

    <!-- Data Table Container -->
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <!-- Table Header Row -->
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10" CornerRadius="10,10,0,0">
          <Grid ColumnDefinitions="60,90,2*,2*,120,120,100">
            <TextBlock Text="КОД" Grid.Column="0" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
            <TextBlock Text="ОТДЕЛ" Grid.Column="1" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
            <TextBlock Text="Ф.И.О. СОТРУДНИКА" Grid.Column="2" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
            <TextBlock Text="ДОЛЖНОСТЬ" Grid.Column="3" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
            <TextBlock Text="ОКЛАД (РУБ.)" Grid.Column="4" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
            <TextBlock Text="ПРЕМИЯ (РУБ.)" Grid.Column="5" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
            <TextBlock Text="МЕСЯЦ" Grid.Column="6" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
          </Grid>
        </Border>

        <!-- Table Data Rows -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" Background="Transparent" Padding="8,4">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,10"/>
              <Setter Property="Margin" Value="0,2"/>
              <Setter Property="CornerRadius" Value="6"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="#EEF2FF"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="60,90,2*,2*,120,120,100">
                <TextBlock Text="{Binding Id}" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                <Border Grid.Column="1" Background="#F1F5F9" Padding="6,2" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DepartmentCode}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                </Border>
                <TextBlock Text="{Binding FullName}" Grid.Column="2" VerticalAlignment="Center" FontWeight="Medium" Foreground="#1E293B"/>
                <TextBlock Text="{Binding Position}" Grid.Column="3" VerticalAlignment="Center" Foreground="#475569"/>
                <TextBlock Text="{Binding Salary, StringFormat='{}{0:N2}'}" Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="{Binding Bonus, StringFormat='{}{0:N2}'}" Grid.Column="5" VerticalAlignment="Center" Foreground="#059669" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Month}" Grid.Column="6" VerticalAlignment="Center" Foreground="#64748B"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>