<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:KursMVVM.Converters"
             x:Class="KursMVVM.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <converters:StringToIntConverter x:Key="StringToIntConverter"/>
    <converters:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
    <converters:StringToDateTimeConverter x:Key="StringToDateTimeConverter"/>
    <converters:DateTimeToDateTimeOffsetConverter x:Key="DateTimeToDateTimeOffsetConverter"/>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />

    <!-- Modern Minimalist Global Styles -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Background" Value="#F8FAFC"/>
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Background" Value="#F8FAFC"/>
    </Style>

    <Style Selector="DatePicker">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="Background" Value="#F8FAFC"/>
    </Style>
  </Application.Styles>
</Application>